# ── .env.evo-evogo.example — stack "EVO + EVOGO" (só as duas APIs de WhatsApp) ──
# Uso:
#   cp .env.evo-evogo.example .env.evo-evogo   &&   edite os valores
#   docker compose -f docker-compose.evo-evogo.yml --env-file .env.evo-evogo up -d
#
# Segredos: openssl rand -hex 32
# Nunca comitar o .env.evo-evogo preenchido (chmod 600).

# ═══════════ Imagens (tag FIXA — 3rd-party; confirme a tag estável antes de subir) ═══════════
EVO_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOGO_IMAGE=evoapicloud/evolution-go:0.7.2

# ═══════════ Postgres (compartilhado pelas duas APIs, multi-DB) ═══════════
PG_PASSWORD=TROQUE_SENHA_PG
POSTGRES_USER=postgres
POSTGRES_DB=postgres        # DB de administração; os 3 DBs reais o db-init cria.

# ═══════════ Chaves das APIs ═══════════
# Evolution API: header `apikey`. Também é a senha de login do Manager embutido (/manager).
EVO_GLOBAL_KEY=TROQUE_EVO_GLOBAL_KEY
# Evolution GO: header `apikey` global.
EVOGO_GLOBAL_KEY=TROQUE_EVOGO_GLOBAL_KEY

# ═══════════ Evolution API ═══════════
# Como o BROWSER / o consumidor da API enxergam a Evolution. Entra nos links de mídia dos
# webhooks — se estiver errado, a mídia chega com URL que ninguém consegue baixar.
EVO_SERVER_URL=http://localhost:18080
EVO_LANGUAGE=pt-BR
EVO_LOG_LEVEL=ERROR,WARN,INFO
EVO_SESSION_CLIENT=Evolution API      # nome que aparece em "Dispositivos conectados" no celular
EVO_SESSION_BROWSER=Chrome
EVO_WEBSOCKET_ENABLED=false
# Webhook GLOBAL (opcional). Deixe false/vazio para configurar webhook POR INSTÂNCIA via API.
EVO_WEBHOOK_GLOBAL_ENABLED=false
EVO_WEBHOOK_GLOBAL_URL=

# ═══════════ Evolution GO ═══════════
# E-mail do 1º registro de licença → re-ativação headless (/v1/register/auto) nos boots
# seguintes. Deixe vazio na PRIMEIRA subida, ative a licença no Manager UI, depois preencha.
EVOLUTION_OPERATOR_EMAIL=voce@dominio.com
EVOGO_OS_NAME=Evolution GO            # nome que aparece em "Dispositivos conectados" no celular
EVOGO_WADEBUG=INFO                    # INFO | DEBUG (DEBUG é MUITO verboso)
EVOGO_SAVE_MESSAGES=false             # true = persiste o corpo das mensagens no evogo_users
EVOGO_CONNECT_ON_STARTUP=false        # true = religa as instâncias sozinho no boot
EVOGO_WEBHOOK_URL=                    # webhook GLOBAL (opcional); vazio = desligado
# Passkey (WebAuthn) — só para contas que exigem passkey ao vincular dispositivo.
# Precisa ser URL PÚBLICA desta API, alcançável pelo browser que abre o web.whatsapp.com
# (domínio público ou túnel ngrok/cloudflared — NÃO localhost se o browser for outra máquina).
EVOGO_PASSKEY_PUBLIC_URL=

# ═══════════ Portas locais (host, só 127.0.0.1) ═══════════
# Faixa 18xxx para não colidir com a stack ../integracoes/ (que usa 17xxx / 8082).
EVO_PORT=18080            # Evolution API + Manager embutido: http://127.0.0.1:18080/manager
EVOGO_PORT=18082          # Evolution GO Manager (ativar licença): http://127.0.0.1:18082/manager/login
DB_PORT=18544             # Postgres (psql/DBeaver a partir do host)
